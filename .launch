#!/bin/sh

# NOTE: HEFER_MACHINE_TYPE lives here
. "$HOME/.machine"

export CURSOR_SIZE="24"
export XDG_MENU_PREFIX="arch-"
export NIRI_CONFIG="$HOME/.config/niri/$HEFER_MACHINE_TYPE-config.kdl"

# Just to be safe
systemctl --user import-environment HEFER_MACHINE_TYPE NIRI_CONFIG CURSOR_SIZE XDG_MENU_PREFIX

exec niri-session
