# Aliases

alias update="sudo pacman -Syu;yay"
alias useless='pacman -Qdtq'
alias autoremove='pacman -Qdtq | sudo pacman -Rs -'

alias dotfiles='/usr/bin/git --git-dir="$HOME/.dotfiles/" --work-tree="$HOME"'

alias launch-isis='docker compose -f docker-compose-all-apps-dev.yml build && docker compose -f docker-compose-all-apps-dev.yml up'
alias launch-isis-dev='docker compose -f docker-compose-all-apps-dev.yml build && docker compose -f docker-compose-all-apps-dev.yml --profile dev up'
alias stop-isis='docker compose -f docker-compose-all-apps-dev.yml down -v --remove-orphans'
alias clean-isis-db='sudo rm -rf server/postgres/data;sudo rm -rf server/orthanc/orthanc_db'
alias test-isis='docker compose -f docker-compose-all-apps-dev.yml exec api pytest'
alias generate-isis-migration='docker compose -f docker-compose-all-apps-dev.yml exec api alembic revision --autogenerate -m'
alias migrate-isis-db='docker compose -f docker-compose-all-apps-dev.yml exec api alembic upgrade head'
