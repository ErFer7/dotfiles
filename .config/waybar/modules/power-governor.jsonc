{
  "custom/power-governor": {
    "return-type": "json",
    "format": "{icon}",
    "tooltip-format": "{icon}",
    "format-icons": {
      "0": "",
      "1": "",
      "2": "",
      "3": ""
    },
    "exec": "~/.config/waybar/scripts/power-governor.sh",
    "tooltip": true,
    "interval": 1
  }
}
